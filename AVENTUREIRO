#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

struct Territorio {
    char nome[30];
    char cor[10];
    int tropas;
};

// Protótipos das funções
void cadastrarTerritorios(struct Territorio* mapa, int quantidade);
void exibirTerritorios(struct Territorio* mapa, int quantidade);
void atacar(struct Territorio* atacante, struct Territorio* defensor);
void liberarMemoria(struct Territorio* mapa);
int selecionarTerritorio(struct Territorio* mapa, int quantidade, const char* mensagem, const char* corAtacante);

int main() {
    struct Territorio* territorios;
    int quantidade;
    int atacanteIdx, defensorIdx;
    
    // Inicializa o gerador de números aleatórios
    srand(time(NULL));
    
    printf("=== SISTEMA DE WAR - SIMULADOR DE BATALHAS ===\n\n");
    
    // Solicita a quantidade de territórios
    printf("Quantos territorios deseja cadastrar? ");
    scanf("%d", &quantidade);
    getchar(); // Limpa o buffer
    
    // Aloca memória dinamicamente para os territórios
    territorios = (struct Territorio*)calloc(quantidade, sizeof(struct Territorio));
    
    // Verifica se a alocação foi bem-sucedida
    if (territorios == NULL) {
        printf("Erro ao alocar memória!\n");
        return 1;
    }
    
    // Cadastra os territórios
    cadastrarTerritorios(territorios, quantidade);
    
    // Exibe os territórios cadastrados
    exibirTerritorios(territorios, quantidade);
    
    // Menu de ataques
    char continuar = 's';
    while (continuar == 's' || continuar == 'S') {
        printf("\n=== SIMULAÇÃO DE ATAQUE ===\n");
        
        // Seleciona o território atacante
        atacanteIdx = selecionarTerritorio(territorios, quantidade, 
                                           "Selecione o territorio ATACANTE", NULL);
        
        // Seleciona o território defensor (não pode ser da mesma cor)
        defensorIdx = selecionarTerritorio(territorios, quantidade, 
                                           "Selecione o territorio DEFENSOR", 
                                           territorios[atacanteIdx].cor);
        
        // Realiza o ataque
        printf("\n--- BATALHA: %s (%s) vs %s (%s) ---\n",
               territorios[atacanteIdx].nome, territorios[atacanteIdx].cor,
               territorios[defensorIdx].nome, territorios[defensorIdx].cor);
        
        atacar(&territorios[atacanteIdx], &territorios[defensorIdx]);
        
        // Exibe o resultado atualizado
        printf("\n=== SITUAÇÃO APÓS O ATAQUE ===\n");
        printf("ATACANTE: %s - Cor: %s - Tropas: %d\n",
               territorios[atacanteIdx].nome, territorios[atacanteIdx].cor, 
               territorios[atacanteIdx].tropas);
        printf("DEFENSOR: %s - Cor: %s - Tropas: %d\n",
               territorios[defensorIdx].nome, territorios[defensorIdx].cor, 
               territorios[defensorIdx].tropas);
        
        // Pergunta se deseja continuar
        printf("\nDeseja realizar outro ataque? (s/n): ");
        scanf(" %c", &continuar);
        getchar();
    }
    
    // Exibe o estado final dos territórios
    printf("\n=== ESTADO FINAL DOS TERRITÓRIOS ===\n");
    exibirTerritorios(territorios, quantidade);
    
    // Libera a memória alocada
    liberarMemoria(territorios);
    
    printf("\nPrograma encerrado. Memória liberada com sucesso!\n");
    
    return 0;
}


void cadastrarTerritorios(struct Territorio* mapa, int quantidade) {
    printf("\n=== CADASTRO DE TERRITÓRIOS ===\n");
    
    for (int i = 0; i < quantidade; i++) {
        printf("\n--- Territorio %d ---\n", i + 1);
        
        // Limpa o buffer e lê o nome
        getchar();
        printf("Nome do territorio: ");
        fgets((mapa + i)->nome, 30, stdin);
        (mapa + i)->nome[strcspn((mapa + i)->nome, "\n")] = 0; // Remove o \n
        
        // Lê a cor do exército
        printf("Cor do exercito (ex: Vermelho, Azul, Verde): ");
        fgets((mapa + i)->cor, 10, stdin);
        (mapa + i)->cor[strcspn((mapa + i)->cor, "\n")] = 0;
        
        // Lê a quantidade de tropas
        printf("Quantidade de tropas: ");
        scanf("%d", &(mapa + i)->tropas);
        
        // Validação básica
        while ((mapa + i)->tropas < 1) {
            printf("Quantidade inválida! Digite pelo menos 1 tropa: ");
            scanf("%d", &(mapa + i)->tropas);
        }
    }
}


void exibirTerritorios(struct Territorio* mapa, int quantidade) {
    printf("\n=== TERRITÓRIOS CADASTRADOS ===\n\n");
    
    for (int i = 0; i < quantidade; i++) {
        printf("Territorio %d:\n", i + 1);
        printf("  Nome: %s\n", (mapa + i)->nome);
        printf("  Cor do exercito: %s\n", (mapa + i)->cor);
        printf("  Tropas: %d\n", (mapa + i)->tropas);
        printf("  -------------\n");
    }
}


void atacar(struct Territorio* atacante, struct Territorio* defensor) {
    int dadoAtacante, dadoDefensor;
    int tropasPerdidas;
    
    // Verifica se o atacante tem tropas suficientes
    if (atacante->tropas <= 1) {
        printf("ERRO: Territorio atacante não tem tropas suficientes para atacar!\n");
        return;
    }
    
    // Simula os dados (1 a 6)
    dadoAtacante = rand() % 6 + 1;
    dadoDefensor = rand() % 6 + 1;
    
    printf("\n[ROLAGEM DE DADOS]\n");
    printf("Atacante rolou: %d\n", dadoAtacante);
    printf("Defensor rolou: %d\n", dadoDefensor);
    
    // Determina o resultado da batalha
    if (dadoAtacante > dadoDefensor) {
        // Ataque bem-sucedido - conquista o território
        printf("\nVITORIA DO ATACANTE! Territorio conquistado!\n");
        
        // Transfere a cor do atacante para o defensor
        strcpy(defensor->cor, atacante->cor);
        
        // Calcula metade das tropas do atacante (mínimo 1)
        tropasPerdidas = atacante->tropas / 2;
        if (tropasPerdidas < 1) tropasPerdidas = 1;
        
        // Atualiza as tropas
        atacante->tropas -= tropasPerdidas;
        defensor->tropas = tropasPerdidas;
        
        printf("O territorio %s agora pertence ao exercito %s!\n", 
               defensor->nome, defensor->cor);
        printf("Tropas transferidas: %d\n", tropasPerdidas);
    } 
    else if (dadoAtacante < dadoDefensor) {
        // Ataque mal-sucedido - atacante perde uma tropa
        printf("\nDERROTA DO ATACANTE! Ataque repelido!\n");
        atacante->tropas--;
        printf("O atacante perdeu 1 tropa!\n");
    } 
    else {
        // Empate - atacante perde uma tropa
        printf("\nEMPATE! Ataque repelido!\n");
        atacante->tropas--;
        printf("O atacante perdeu 1 tropa!\n");
    }
    
    // Garante que as tropas não fiquem negativas
    if (atacante->tropas < 0) atacante->tropas = 0;
    if (defensor->tropas < 0) defensor->tropas = 0;
}

void liberarMemoria(struct Territorio* mapa) {
    if (mapa != NULL) {
        free(mapa);
    }
}

int selecionarTerritorio(struct Territorio* mapa, int quantidade, 
                          const char* mensagem, const char* corAtacante) {
    int escolha;
    
    do {
        printf("\n%s:\n", mensagem);
        for (int i = 0; i < quantidade; i++) {
            printf("  %d - %s (%s - %d tropas)\n", 
                   i + 1, (mapa + i)->nome, (mapa + i)->cor, (mapa + i)->tropas);
        }
        
        printf("Digite o numero do territorio: ");
        scanf("%d", &escolha);
        escolha--; // Ajusta para índice 0-based
        
        if (escolha < 0 || escolha >= quantidade) {
            printf("Opção inválida! Tente novamente.\n");
        }
        // Se for um ataque, verifica se não está atacando território da mesma cor
        else if (corAtacante != NULL && strcmp((mapa + escolha)->cor, corAtacante) == 0) {
            printf("Voce nao pode atacar seu proprio territorio! Escolha outro.\n");
            escolha = -1;
        }
        else if ((mapa + escolha)->tropas <= 0 && corAtacante != NULL) {
            printf("Este territorio nao tem tropas para ser atacado!\n");
            escolha = -1;
        }
        
    } while (escolha < 0 || escolha >= quantidade);
    
    return escolha;
}